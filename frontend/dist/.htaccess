# ─────────────────────────────────────────────────────────────────────
#  Webgrat frontend — Hostinger (Apache / LiteSpeed)
#  Deployed by uploading the contents of  dist/  into  public_html/.
# ─────────────────────────────────────────────────────────────────────

Options -MultiViews
RewriteEngine On

# 1) Force HTTPS (Hostinger issues a free Let's Encrypt cert).
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Canonical host: send the apex  webgrat.com  → www.webgrat.com.
#    Comment this block out if you'd rather make the apex canonical.
RewriteCond %{HTTP_HOST} ^webgrat\.com$ [NC]
RewriteRule ^(.*)$ https://www.webgrat.com/$1 [L,R=301]

# 3) Single-page-app fallback — anything that is NOT a real file or
#    directory falls through to index.html so React Router can take over.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# 4) Long-cache hashed assets, never-cache the HTML shell.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|ttf|eot|svg|jpg|jpeg|png|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# 5) Gzip compression for text-y assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 6) Pretty MIME for fonts.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
