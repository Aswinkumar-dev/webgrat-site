# ─────────────────────────────────────────────────────────────────────
#  Webgrat frontend env vars (Vite reads these at BUILD time)
# ─────────────────────────────────────────────────────────────────────
#  Local dev   :  copy this file to  .env   and use localhost values
#  Production  :  copy this file to  .env.production  and use the
#                 Render backend URL + your Supabase project URL/key,
#                 then run  npm run build  before uploading dist/ to
#                 Hostinger's public_html/.
#
#  IMPORTANT: Vite bakes these into the bundle at build time. Hostinger
#  shared hosting has NO concept of runtime env vars — that's why we
#  build locally / in CI with the right .env.production values present.
# ─────────────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# Spring Boot backend on Render.
#   • Local dev   : http://localhost:8080
#   • Production  : https://api.webgrat.com   (custom domain on Render)
#                   or  https://webgrat-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8080
